---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LatentBackground from '../components/LatentBackground.astro';
import Hero from '../components/Hero.astro';
import AcademicJourney from '../components/AcademicJourney.astro';
import ResearchApproach from '../components/ResearchApproach.astro';
import SelectedProjects from '../components/SelectedProjects.astro';
import Publications from '../components/Publications.astro';
import About from '../components/About.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
  <SiteHeader />

  <main id="top">
    <LatentBackground />

    <Hero />
    <ResearchApproach />
    <Publications />
    <SelectedProjects />
    <AcademicJourney />
    <About />
  </main>

  <SiteFooter />
</BaseLayout>
